<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>RadioRadar — локальная проверка аномалий</title>
<style>
:root{color-scheme:dark;font-family:system-ui,-apple-system,Arial,sans-serif;background:#0c1422;color:#edf5ff}*{box-sizing:border-box}body{margin:0;padding:16px;max-width:760px;margin-inline:auto}h1{font-size:1.55rem;margin:12px 0}h2{font-size:1rem}p,small{color:#b5c6dc;line-height:1.5}section{background:#17253a;border:1px solid #324760;border-radius:14px;padding:17px;margin:14px 0}button,input,textarea{font:inherit;border-radius:8px;padding:10px}button{color:white;background:#2672b7;border:0;cursor:pointer;margin:4px 4px 4px 0}button.secondary{background:#34445d}input[type=file]{max-width:100%;background:#101c30}textarea{color:#e8f2ff;background:#101c30;width:100%;min-height:125px;border:1px solid #486080}output{display:block;margin-top:12px}.status{padding:13px;border-radius:11px;background:#24314a;border-left:5px solid #94a6bf}.anomaly{border-left-color:#ffad31;background:#3a2b22}.normal{border-left-color:#64c79c}.unknown{border-left-color:#8ea4c2}table{width:100%;border-collapse:collapse;font-size:.9rem}th,td{text-align:left;border-bottom:1px solid #35465c;padding:9px 6px}kbd{background:#283851;padding:2px 4px;border-radius:3px}#detail{overflow-wrap:anywhere}label{display:block;margin:9px 0}.error{color:#ffb5a5}strong{color:white}
</style>
</head>
<body>
<header><small>RadioRadar · безопасность · автономный лабораторный режим</small><h1>Аномалии собственного радиофона</h1><p>Работает на устройстве: без карты, GPS, отправки измерений и запросов к внешним сервисам. Не определяет людей, рации, местоположение или степень угрозы.</p></header>
<section><h2>1. Загрузите измерения собственного приёмника</h2><p>CSV или JSON. Каждая запись: время <kbd>timestamp</kbd>, частота <kbd>frequency_mhz</kbd>, уровень <kbd>power_dbm</kbd>. Для корректного сравнения измерения должны быть выполнены одним прибором с одинаковыми настройками. Можно вставить JSON вручную.</p><input id="file" type="file" accept=".csv,.json,.txt,application/json,text/csv"><label for="raw">Вставить измерения</label><textarea id="raw" spellcheck="false" placeholder='[{"timestamp":"2026-10-10T08:00:00Z","frequency_mhz":433.92,"power_dbm":-90}]'></textarea><div><button id="analyze">Анализировать</button><button class="secondary" id="demo">Показать демонстрацию</button><button class="secondary" id="clear">Очистить всё</button></div><small>Демонстрационные данные придуманы только для проверки интерфейса и никогда не являются настоящим предупреждением.</small></section>
<section aria-live="polite"><h2>2. Результат</h2><output id="result" class="status unknown">Нет данных для оценки.</output><div id="detail"></div></section>
<section><h2>3. Метод анализа</h2><p>Для каждой частоты берутся минимум 12 базовых и 3 новых измерения. По временной последовательности последние 3 сравниваются с медианой предыдущих значений. Предупреждение о <em>статистической аномалии</em> появляется, если медиана новых измерений превышает историческую медиану на более чем <strong>12 дБ</strong> и не менее чем вдвое превосходит медианное абсолютное отклонение с поправкой 1,4826 и множителем 6. Это экспериментальный порог, а не стандарт безопасности.</p><p>Статус «Измерения без аномалий» означает только отсутствие превышения тестового порога в предоставленном наборе. Ни один результат не подтверждает присутствие или отсутствие людей и не гарантирует безопасность.</p></section>
<script>
(()=>{'use strict';
const $=id=>document.getElementById(id), result=$('result'),detail=$('detail');
function median(a){const s=[...a].sort((x,y)=>x-y),k=Math.floor(s.length/2);return s.length%2?s[k]:(s[k-1]+s[k])/2}
function escapeHTML(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function csvParse(text){const lines=text.replace(/^\uFEFF/,'').trim().split(/\r?\n/).filter(Boolean);if(lines.length<2)throw Error('В CSV нет строк данных');const delim=lines[0].includes(';')?';':',';const headings=lines[0].split(delim).map(x=>x.trim().toLowerCase());return lines.slice(1).map(line=>{const a=line.split(delim);return Object.fromEntries(headings.map((h,i)=>[h,a[i]?.trim()]))})}
function parse(text){let items;try{const data=JSON.parse(text);items=Array.isArray(data)?data:data.measurements}catch{items=csvParse(text)}if(!Array.isArray(items))throw Error('Ожидается массив измерений или объект measurements');if(items.length>20000)throw Error('Максимум 20000 записей');const out=items.map((item,i)=>{const timestamp=Date.parse(item.timestamp),freq=Number(item.frequency_mhz),power=Number(item.power_dbm);if(!Number.isFinite(timestamp)||!Number.isFinite(freq)||freq<=0||!Number.isFinite(power)||power>50||power< -200)throw Error('Неправильные поля в строке '+(i+1));return {timestamp,freq,power}});return out}
function analyze(rows){const byFrequency=new Map();for(const r of rows){const key=r.freq.toFixed(4);if(!byFrequency.has(key))byFrequency.set(key,[]);byFrequency.get(key).push(r)}const groups=[];for(const [key,raw] of byFrequency){const group=raw.sort((a,b)=>a.timestamp-b.timestamp);if(group.length<15){groups.push({key,n:group.length,ready:false});continue}const base=group.slice(0,-3).map(r=>r.power),current=group.slice(-3).map(r=>r.power);const historical=median(base),recent=median(current),mad=median(base.map(x=>Math.abs(x-historical)));const change=recent-historical;const threshold=Math.max(12,6*1.4826*mad);groups.push({key,n:group.length,ready:true,historical,recent,change,threshold,anomaly:change>threshold})}return groups}
function display(message,cls){result.className='status '+cls;result.textContent=message}
function render(rows,isDemo){const groups=analyze(rows),ready=groups.filter(g=>g.ready),alerts=ready.filter(g=>g.anomaly);if(!ready.length)display('НЕТ ДАННЫХ: для анализа нужно минимум 15 измерений на одной частоте.','unknown');else if(alerts.length)display((isDemo?'ДЕМОНСТРАЦИЯ · ':'')+'АНОМАЛИЯ ИЗМЕРЕНИЙ: порог превышен в '+alerts.length+' частотной группе(ах). Это не свидетельствует о присутствии людей.','anomaly');else display((isDemo?'ДЕМОНСТРАЦИЯ · ':'')+'ИЗМЕРЕНИЯ БЕЗ АНОМАЛИЙ: превышений тестового порога не найдено. Это не означает безопасность.','normal');const summary='<p>Записей: '+rows.length+'; частот: '+groups.length+'; с достаточной историей: '+ready.length+'.'+(isDemo?' <strong>ДЕМОНСТРАЦИОННЫЕ ДАННЫЕ</strong>':'')+'</p>';const head='<table><thead><tr><th>Частота, МГц</th><th>Записей</th><th>Изменение</th><th>Результат</th></tr></thead><tbody>';const body=groups.slice(0,50).map(g=>'<tr><td>'+escapeHTML(g.key)+'</td><td>'+g.n+'</td><td>'+(g.ready?g.change.toFixed(1)+' дБ':'—')+'</td><td>'+(g.ready?(g.anomaly?'Аномалия':'Без аномалий'):'Нет данных')+'</td></tr>').join('');detail.innerHTML=summary+head+body+'</tbody></table>'+(groups.length>50?'<p>Показаны первые 50 частотных групп.</p>':'')}
function run(){detail.textContent='';try{const text=$('raw').value.trim();if(!text){display('НЕТ ДАННЫХ: сначала загрузите собственные измерения.','unknown');return}render(parse(text),false)}catch(e){display('Не удалось разобрать измерения.','unknown');detail.innerHTML='<p class="error">'+escapeHTML(e.message)+'</p>'}}
$('analyze').addEventListener('click',run);
$('file').addEventListener('change',async e=>{const file=e.target.files?.[0];if(!file)return;if(file.size>3000000){display('Файл превышает лимит 3 МБ.','unknown');return}try{$('raw').value=await file.text();run()}catch{display('Не удалось прочитать файл.','unknown')}});
$('clear').addEventListener('click',()=>{$('raw').value='';$('file').value='';detail.textContent='';display('НЕТ ДАННЫХ: данные удалены из окна.','unknown')});
$('demo').addEventListener('click',()=>{const data=[];const t=Date.parse('2026-10-01T10:00:00Z');for(let i=0;i<22;i++){data.push({timestamp:new Date(t+i*60000).toISOString(),frequency_mhz:433.92,power_dbm:i<19?-91+(i%3): -67+(i%2)});data.push({timestamp:new Date(t+i*60000).toISOString(),frequency_mhz:145.5,power_dbm:-90+(i%3)})}render(parse(JSON.stringify(data)),true)});
})();
</script>
</body></html>
