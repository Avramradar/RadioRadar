<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#081524">
<title>RadioRadar — журнал RF-измерений</title>
<style>
:root{color-scheme:dark;--bg:#081524;--panel:#101f31;--edge:#294157;--muted:#b3c5d5;--text:#eef8ff;--aqua:#49dcc4;--warn:#ffbf75;--red:#ff8b8b}*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font:15px/1.5 system-ui,-apple-system,Segoe UI,sans-serif}header{background:#12273b;border-bottom:1px solid var(--edge);padding:20px 16px}header>div,main{max-width:850px;margin:auto}h1{font-size:24px;margin:0}h2{font-size:18px;margin:0 0 10px}p{margin:7px 0;color:var(--muted)}small,.minor{font-size:12px;color:var(--muted)}main{padding:14px 12px 50px}.panel{border:1px solid var(--edge);border-radius:17px;background:var(--panel);padding:17px;margin:0 0 13px}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.wide{grid-column:1/-1}label{display:flex;flex-direction:column;gap:5px;font-size:13px;font-weight:650;color:#d4e6f5}input,select,textarea,button{font:inherit}input,select,textarea{width:100%;min-width:0;background:#0b1a2a;color:var(--text);border:1px solid #385169;border-radius:10px;padding:12px}textarea{resize:vertical;min-height:70px}input:focus,select:focus,textarea:focus{outline:2px solid var(--aqua);outline-offset:1px}button,.button{border:1px solid #385a6b;border-radius:10px;padding:11px 13px;background:#1b3449;color:#f5fbff;cursor:pointer;font-weight:650}button.primary{background:#27bfa9;color:#05282a;border-color:#27bfa9}button:disabled{opacity:.45}.actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:13px}.actions button{flex:1;min-width:125px}.status{border-radius:12px;border:1px solid #4e6377;padding:13px;background:#1a3144}.status.warn{border-color:#bb763c;background:#3a2c20}.status.ok{border-color:#408978;background:#163b36}.status.bad{border-color:#ad555c;background:#44262a}.status strong{display:block;font-size:17px}.kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}.kpi{padding:11px;border:1px solid var(--edge);border-radius:10px;background:#0e1a2b}.kpi b{display:block;font-size:23px}.kpi span{font-size:12px;color:var(--muted)}.scroll{overflow:auto;border-radius:10px;border:1px solid var(--edge)}table{border-collapse:collapse;width:100%;min-width:660px;font-si
ze:12px}th,td{padding:10px;text-align:left;vertical-align:top;border-bottom:1px solid #2b4053}th{background:#1a3145;color:#dce9f7}td{overflow-wrap:anywhere}tr:last-child td{border-bottom:0}.tag{display:inline-block;padding:3px 8px;border-radius:20px;background:#254257}.tag.warn{background:#694422;color:#ffdda7}.tag.ok{background:#24584b;color:#b1f7df}.tag.nodata{background:#354456}.privacy{background:#142d36;border:1px solid #2f6673;border-radius:11px;padding:12px}.hidden{display:none!important}.pill{border:1px solid var(--edge);border-radius:12px;padding:10px;color:#c4d9e8}.fileinput{position:absolute;clip-path:inset(50%);width:1px;height:1px;overflow:hidden}.chart{width:100%;height:auto;background:#0c1b2a;border:1px solid var(--edge);border-radius:12px}#chartText{font-size:12px;color:var(--muted)}@media(max-width:550px){.grid{grid-template-columns:1fr}.wide{grid-column:auto}.kpis{grid-template-columns:repeat(3,minmax(0,1fr))}.kpi b{font-size:20px}header{padding:17px 14px}h1{font-size:21px}}
</style>
</head>
<body>
<header><div><h1>◉ RadioRadar · Ручные измерения</h1><p>Приватный журнал радиочастотных измерений и поиск статистических отклонений</p></div></header>
<main>
<section class="panel"><h2>1. Проект и территория</h2><p>Назови территорию произвольно. Координаты не нужны: приложение не определяет положение источников сигнала.</p>
<div class="grid"><label>Название территории<input id="area" maxlength="80" placeholder="Например: Испытательный участок А"></label><label>Описание или условия<input id="conditions" maxlength="120" placeholder="Помещение, открытая местность…"></label></div>
<div class="privacy" style="margin-top:13px"><strong>Конфиденциальность</strong><div class="minor">Записи хранятся только в локальном хранилище браузера этого устройства. Никакой геолокации, учётных записей или сетевой отправки измерений здесь нет. При очистке данных браузера записи могут исчезнуть — пользуйся экспортом.</div></div></section>
<section class="panel"><h2>2. Добавить измерение</h2><p>Вводи фактические показания <strong>собственного или разрешённого измерительного оборудования</strong>. Не подставляй приблизительную мощность, если прибор её не показывает.</p>
<form id="form"><div class="grid">
<label>Дата и время<input id="when" type="datetime-local" required></label>
<label>Идентификатор измерительной серии<input id="series" maxlength="40" required placeholder="Например: тест-01"></label>
<label>Центральная частота, МГц<input id="freq" type="number" min="0.001" max="100000" step="any" required placeholder="Например: 433.92"></label>
<label>Уровень сигнала, dBm<input id="level" type="number" min="-200" max="100" step="any" required placeholder="Например: -84"></label>
<label>Способ измерения<select id="method"><option value="Измеритель RF">Измеритель RF</option><option value="SDR / спектроанализатор">SDR / спектроанализатор</option><option value="Измеритель Wi-Fi">Измеритель Wi-Fi</option><option value="Учебная запись">Учебная запись</option><option value="Другой прибор">Другой прибор</option></select></label>
<label>Качество измерения<select id="quality"><option value="Подтверждено">Подтверждено</option><option value="Сомнительно">Сомнительно</option></select></label>
<label class="wide">Примечание (необязательно)<textarea id="note" maxlength="300" placeholder="Условия приёма, помехи, модель оборудования…"></textarea></label>
</div><div class="actions"><button class="primary" type="submit">＋ Сохранить измерение</button><button type="button" id="fillDemo">Загрузить учебный пример</button></div></form>
<div id="feedback" class="minor" role="status" aria-live="polite" style="margin-top:10px"></div></section>
<section class="panel"><h2>3. Анализ отклонений</h2><p>Сравниваются измерения одной серии и одной частоты. Для построения фона нужны минимум три предыдущих подтверждённых показания.</p>
<div class="grid"><label>Порог повышения над медианой фона, дБ<input id="threshold" type="number" min="1" max="60" step="1" value="12"></label><label>Фильтр по серии<select id="seriesFilter"><option value="">Все серии</option></select></label><label class="wide">Фильтр по частоте<select id="freqFilter"><option value="">Все частоты</option></select></label></div>
<div class="actions"><button class="primary" id="analyze" type="button">Проверить измерения</button><button type="button" id="clearFilters">Сбросить фильтры</button></div>
<div id="result" class="status" role="status" aria-live="polite" style="margin-top:12px"><strong>Нет данных для оценки</strong><div class="minor">Введи измерения и запусти проверку.</div></div>
<div class="kpis" style="margin-top:13px"><div class="kpi"><b id="count">0</b><span>Записей</span></div><div class="kpi"><b id="channels">0</b><span>Серий / частот</span></div><div class="kpi"><b id="anomalies">0</b><span>Отклонений</span></div></div>
<svg id="chart" class="chart" viewBox="0 0 700 230" role="img" aria-label="Исторические уровни сигнала" style="margin-top:13px"><text x="20" y="118" font-size="16" fill="#b3c5d5">График появится после ввода измерений</text></svg>
<div id="chartText">График отображает уровни выбранной серии и частоты, но не местоположение передатчиков.</div></section>
<section class="panel"><h2>4. Журнал измерений</h2><div class="scroll"><table><thead><tr><th>Дата</th><th>Серия</th><th>Частота</th><th>dBm</th><th>Оценка</th><th>Действие</th></tr></thead><tbody id="rows"><tr><td colspan="6">Измерений нет</td></tr></tbody></table></div><div class="actions"><button type="button" id="exportJson">Экспорт JSON</button><button type="button" id="exportCsv">Экспорт CSV</button><button type="button" id="importBtn">Импорт JSON</button><button type="button" id="clearAll">Очистить журнал</button></div><input class="fileinput" id="importFile" type="file" accept=".json,application/json"><p class="minor">Экспорт включает записи и название территории. Проверь данные перед передачей другим людям.</p></section>
<section class="panel"><h2>Важно о результатах</h2><div class="pill">⚠️ <strong>«Аномалия» не означает «Опасность».</strong> Это статистическое превышение предыдущего уровня по вручную внесённым показаниям. Оно не подтверждает наличие людей, направление, дистанцию или местоположение передатчика. Отсутствие аномалии не гарантирует безопасность.</div></section>
</main>
<script>
(()=>{'use strict';
const $=id=>document.getElementById(id),STORE='radioradar_manual_rf_v1';let records=[],analyses=new Map();
function nowLocal(){const d=new Date(),p=n=>String(n).padStart(2,'0');return `${d.getFullYear()}-${p(d.getMonth()+1)}-${p(d.getDate())}T${p(d.getHours())}:${p(d.getMinutes())}`;}
function number(x){return typeof x==='number'?x:Number(x)}
function safeStr(s,max=300){return String(s??'').slice(0,max)}
function read(){try{const x=JSON.parse(localStorage.getItem(STORE)||'{}');if(Array.isArray(x.records))records=x.records.filter(valid).slice(0,20000);$('area').value=safeStr(x.area,80);$('conditions').value=safeStr(x.conditions,120);if(Number.isFinite(number(x.threshold)))$('threshold').value=x.threshold;}catch(e){console.warn('Storage unavailable',e)}}
function valid(x){return x&&typeof x.id==='string'&&typeof x.when==='string'&&!Number.isNaN(Date.parse(x.when))&&typeof x.series==='string'&&x.series.length>0&&Number.isFinite(number(x.freq))&&number(x.freq)>0&&number(x.freq)<=100000&&Number.isFinite(number(x.level))&&number(x.level)>=-200&&number(x.level)<=100&&['Подтверждено','Сомнительно'].includes(x.quality)&&typeof x.method==='string';}
function save(){try{localStorage.setItem(STORE,JSON.stringify({area:$('area').value,conditions:$('conditions').value,threshold:$('threshold').value,records}));$('feedback').textContent='Данные сохранены в браузере.';}catch(e){$('feedback').textContent='Не удалось сохранить в браузере. Экспортируй JSON, чтобы не потерять записи.';}}
function median(a){const b=[...a].sort((x,y)=>x-y),n=b.length;return n%2?b[(n-1)/2]:(b[n/2-1]+b[n/2])/2;}
function selected(){return records.filter(r=>(!$('seriesFilter').value||r.series===$('seriesFilter').value)&&(!$('freqFilter').value||String(r.freq)===$('freqFilter').value)).sort((a,b)=>Date.parse(a.when)-Date.parse(b.when)||a.id.localeCompare(b.id));}
function calculate(){const rows=selected(),groups=new Map(),out=new Map(),threshold=Number($('threshold').value);if(!Number.isFinite(threshold)||threshold<1||threshold>60){$('threshold').value='12';return calculate();}for(const r of rows){const key=JSON.stringify([r.series,r.freq,r.method]);let history=groups.get(key);if(!history){history=[];groups.set(key,history);}if(r.quality!=='Подтверждено'){out.set(r.id,{kind:'uncertain',text:'Сомнительно'});continue;}if(history.length<3){out.set(r.id,{kind:'nodata',text:'Недостаточно фона'});}else{const baseline=median(history.slice(-20));const diff=r.level-baseline;out.set(r.id,{kind:diff>=threshold?'warn':'ok',text:diff>=threshold?'Аномалия +'+diff.toFixed(1)+' дБ':'Без аномалии',diff,baseline});}history.push(r.level);}return {rows,groups,out};}
function optionList(el,vals,placeholder){const prev=el.value;el.replaceChildren();const o=document.createElement('option');o.value='';o.textContent=placeholder;el.appendChild(o);for(const v of vals){const z=document.createElement('option');z.value=String(v);z.textContent=String(v);el.appendChild(z);}if([...el.options].some(x=>x.value===prev))el.value=prev;}
function filters(){optionList($('seriesFilter'),[...new Set(records.map(x=>x.series))].sort(),'Все серии');optionList($('freqFilter'),[...new Set(records.map(x=>x.freq))].sort((a,b)=>a-b).map(x=>String(x)),'Все частоты');}
function cell(t){const x=document.createElement('td');x.textContent=t;return x;}
function draw(rows){const svg=$('chart');while(svg.firstChild)svg.removeChild(svg.firstChild);const key=rows[0]?JSON.stringify([rows[0].series,rows[0].freq,rows[0].method]):null;const subset=key?rows.filter(r=>JSON.stringify([r.series,r.freq,r.method])===key).slice(-40):[];
function shape(tag,attrs,text){const el=document.createElementNS('http://www.w3.org/2000/svg',tag);for(const [k,v] of Object.entries(attrs))el.setAttribute(k,String(v));if(text!==undefined)el.textContent=text;svg.appendChild(el);return el;}
if(!subset.length){shape('text',{x:20,y:118,fill:'#b3c5d5','font-size':16},'Нет измерений для графика');return;}
const min=Math.min(...subset.map(r=>r.level))-8,max=Math.max(...subset.map(r=>r.level))+8,left=55,right=675,top=20,bottom=194,px=i=>left+(subset.length===1?.5:i/(subset.length-1))*(right-left),py=v=>bottom-(v-min)/(max-min)*(bottom-top);
for(let i=0;i<=4;i++){const v=min+(max-min)*i/4,y=py(v);shape('line',{x1:left,y1:y,x2:right,y2:y,stroke:'#29465b','stroke-width':1});shape('text',{x:7,y:y+4,fill:'#bed0de','font-size':12},v.toFixed(0));}
shape('polyline',{points:subset.map((r,i)=>`${px(i)},${py(r.level)}`).join(' '),fill:'none',stroke:'#49dcc4','stroke-width':2.5});for(let i=0;i<subset.length;i++)shape('circle',{cx:px(i),cy:py(subset[i].level),r:3.4,fill:'#49dcc4'});
shape('text',{x:left,y:218,fill:'#b3c5d5','font-size':12},subset[0].when.slice(0,16).replace('T',' '));shape('text',{x:right,y:218,fill:'#b3c5d5','font-size':12,'text-anchor':'end'},subset[subset.length-1].when.slice(0,16).replace('T',' '));}
function render(showSummary=true){filters();const {rows,groups,out}=calculate();analyses=out;$('count').textContent=rows.length;$('channels').textContent=groups.size;const flagged=[...out.values()].filter(x=>x.kind==='warn').length;$('anomalies').textContent=flagged;const tbody=$('rows');tbody.replaceChildren();if(!rows.length){const tr=document.createElement('tr'),td=cell('Измерений нет для выбранных фильтров');td.colSpan=6;tr.appendChild(td);tbody.appendChild(tr);}for(const r of [...rows].reverse().slice(0,300)){const tr=document.createElement('tr');tr.append(cell(r.when.replace('T',' ')),cell(r.series),cell(r.freq.toFixed(3)+' МГц'),cell(r.level.toFixed(1)));const result=out.get(r.id)||{kind:'nodata',text:'Нет данных'},td=cell(''),tag=document.createElement('span');tag.className='tag '+result.kind;tag.textContent=result.text;td.appendChild(tag);tr.appendChild(td);const action=cell(''),del=document.createElement('button');del.textContent='Удалить';del.type='button';del.dataset.delete=r.id;action.appendChild(del);tr.appendChild(action);tbody.appendChild(tr);}draw(rows);
if(showSummary){const result=$('result');result.className='status'+(flagged?' warn':rows.length&&[...out.values()].some(x=>x.kind==='ok')?' ok':'');const headline=document.createElement('strong'),desc=document.createElement('div');desc.className='minor';if(flagged){headline.textContent='Статистические аномалии: '+flagged;desc.textContent='Есть превышения относительно предыдущих подтверждённых значений. Причина и источник неизвестны.';}else if(!rows.length){headline.textContent='Нет данных для оценки';desc.textContent='Нет подходящих измерений.';}else if([...out.values()].some(x=>x.kind==='ok')){headline.textContent='Измерения без выявленных отклонений';desc.textContent='В пределах выбранных рядов превышений порога не выявлено. Это не оценка безопасности.';}else{headline.textContent='Недостаточно данных';desc.textContent='Нужны минимум три предыдущих подтверждённых измерения на каждую серию, частоту и метод.';}result.replaceChildren(headline,desc);}}
$('form').addEventListener('submit',e=>{e.preventDefault();const record={id:(typeof crypto!=='undefined'&&crypto.randomUUID?crypto.randomUUID():Date.now()+'-'+Math.random().toString(36).slice(2)),when:$('when').value,series:$('series').value.trim(),freq:Number($('freq').value),level:Number($('level').value),method:$('method').value,quality:$('quality').value,note:$('note').value.trim()};if(!valid(record)){alert('Проверь дату, серию, частоту и уровень сигнала.');return;}records.push(record);save();render();$('note').value='';$('level').value='';});
$('rows').addEventListener('click',e=>{const id=e.target?.dataset?.delete;if(!id)return;if(confirm('Удалить это измерение?')){records=records.filter(x=>x.id!==id);save();render();}});
for(const id of ['area','conditions','threshold'])$(id).addEventListener('change',()=>{save();if(id==='threshold')render();});
for(const id of ['seriesFilter','freqFilter'])$(id).addEventListener('change',()=>render());$('analyze').addEventListener('click',()=>render());$('clearFilters').addEventListener('click',()=>{$('seriesFilter').value='';$('freqFilter').value='';render();});
function download(name,content,mime){const b=new Blob([content],{type:mime}),url=URL.createObjectURL(b),a=document.createElement('a');a.href=url;a.download=name;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),2000);}
$('exportJson').addEventListener('click',()=>download('radioradar-measurements.json',JSON.stringify({schema_version:1,area:$('area').value,conditions:$('conditions').value,records},null,2),'application/json'));
$('exportCsv').addEventListener('click',()=>{const cols=['when','series','freq','level','method','quality','note'];const q=v=>'"'+String(v??'').replaceAll('"','""')+'"';const lines=[cols.join(','),...records.map(r=>cols.map(c=>q(r[c])).join(','))];download('radioradar-measurements.csv','\ufeff'+lines.join('\r\n'),'text/csv;charset=utf-8');});
$('importBtn').addEventListener('click',()=>$('importFile').click());$('importFile').addEventListener('change',async e=>{const file=e.target.files?.[0];if(!file)return;try{if(file.size>5_000_000)throw Error('Файл слишком большой (максимум 5 МБ).');const data=JSON.parse(await file.text());if(!data||!Array.isArray(data.records))throw Error('Неверная структура JSON.');const ok=data.records.filter(valid);if(ok.length!==data.records.length)throw Error('Некоторые записи повреждены или имеют неверные значения.');if(!confirm('Заменить существующий журнал импортированными '+ok.length+' записями?'))return;records=ok.slice(0,20000);$('area').value=safeStr(data.area,80);$('conditions').value=safeStr(data.conditions,120);save();render();}catch(err){alert('Импорт не выполнен: '+err.message)}finally{e.target.value='';}});
$('clearAll').addEventListener('click',()=>{if(confirm('Безвозвратно удалить все локальные записи? Сначала экспортируй JSON, если данные нужны.')){records=[];save();render();}});
$('fillDemo').addEventListener('click',()=>{if(records.length&&!confirm('Добавить учебные записи к существующим измерениям?'))return;const t=Date.now()-8*60*1000;[-89,-87,-88,-90,-85,-64,-62,-88].forEach((v,i)=>records.push({id:'demo-'+t+'-'+i,when:new Date(t+i*60000).toISOString(),series:'УЧЕБНЫЙ ПРИМЕР',freq:433.92,level:v,method:'Учебная запись',quality:'Подтверждено',note:'Синтетические данные, не реальное RF-измерение.'}));save();render();$('feedback').textContent='Учебные записи добавлены. Они не относятся к реальной территории.';});
$('when').value=nowLocal();read();render();
})();
</script>
</body>
</html>
